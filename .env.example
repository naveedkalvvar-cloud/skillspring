# Authentication (Auth.js / NextAuth v5)
AUTH_SECRET=changeme-generate-a-strong-secret-key-32-chars-min
AUTH_URL=http://localhost:3000

# OAuth Providers
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# Database (Required for signed-in users; guest mode runs without it)
MONGODB_URI=mongodb://localhost:27017/stitch_platform

# LLM Providers (Pick Google Gemini or Anthropic Claude)
# If GEMINI_API_KEY is provided, Gemini (gemini-1.5-flash / gemini-2.0-flash) is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Alternatively, Anthropic Claude:
ANTHROPIC_API_KEY=
LLM_MODEL_GENERATE=claude-3-5-sonnet-20241022

# Mode: 'live' (calls API), 'mock' (instant deterministic offline fallbacks), or 'cache'
LLM_MODE=mock

# Application flags
NEXT_PUBLIC_DEMO_MODE=true
